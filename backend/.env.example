# =================================
# Ayurvedic Meal Planner API Configuration
# =================================

# Flask Configuration
FLASK_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# =================================
# API Keys and Authentication
# =================================

# Groq API keys (get them at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_key_here
GROQ_API_KEY2=your_groq_key_here
GROQ_API_KEY3=your_groq_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Firebase key path
FIREBASE_KEY_PATH=firebase_key.json

# =================================
# Database Configuration
# =================================

GENERATED_PLANS_COL=generated_plans
DOCTOR_EDITS_COL=doctor_edits

# =================================
# Machine Learning Model Configuration  
# =================================

MODEL_PATH=models/dosha_model.pkl
MODEL_VERSION=1.0.0

# =================================
# Dataset Paths
# =================================

FOOD_DATASET_PATH=data/food_dataset.csv
DOSHA_DATASET_PATH=data/dosha_dataset.csv
PATIENT_DATASET_PATH=data/patient_dataset.csv
LIFESTYLE_DATASET_PATH=data/lifestyle_dataset.csv

# =================================
# LLM Configuration
# =================================

DEFAULT_MODEL=llama-3.3-70b-versatile
MAX_TOKENS=2000
TEMPERATURE=0.7
FOOD_SNIPPET_ROWS=60

# =================================
# Rate Limiting & Performance
# =================================

RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=500

CACHE_TYPE=SimpleCache
CACHE_DEFAULT_TIMEOUT=3600

# =================================
# Logging Configuration
# =================================

LOG_LEVEL=INFO
LOG_FORMAT={time} | {level} | {message}# Add this to your existing .env
REACT_APP_API_URL=http://localhost:8000